{
  "id": "firm-households",
  "version": 1,
  "name": "Firm Households",
  "description": "Households (client relationships) for the firm with service tier and location.",
  "category": "Households",
  "enabled": true,
  "scope": { "type": "global" },
  "access": { "groups": ["operations", "advisors", "compliance"], "adminOnly": false },
  "execution": {
    "dataset": "clients",
    "timeoutSeconds": 30,
    "maxRows": 5000,
    "sql": "SELECT ClientId, ClientName, State, Tier, JoinDate FROM clients WHERE FirmId = @firmId AND Tier IN @tiers ORDER BY ClientName ASC"
  },
  "parameters": [
    { "name": "firmId", "source": "firm", "type": "integer", "required": true, "hidden": true },
    {
      "name": "tiers",
      "label": "Service tier",
      "type": "string[]",
      "control": "multiSelect",
      "required": true,
      "default": ["Platinum", "Gold", "Silver", "Bronze"],
      "options": [
        { "value": "Platinum", "label": "Platinum" },
        { "value": "Gold", "label": "Gold" },
        { "value": "Silver", "label": "Silver" },
        { "value": "Bronze", "label": "Bronze" }
      ]
    }
  ],
  "result": {
    "title": "Firm households",
    "defaultPageSize": 25,
    "export": ["csv"],
    "columns": [
      { "field": "ClientId", "label": "Household ID", "type": "integer" },
      { "field": "ClientName", "label": "Household", "type": "string", "pii": true },
      { "field": "State", "label": "State", "type": "string" },
      { "field": "Tier", "label": "Tier", "type": "badge" },
      { "field": "JoinDate", "label": "Since", "type": "date" }
    ]
  },
  "tags": ["households", "clients", "reporting"]
}
