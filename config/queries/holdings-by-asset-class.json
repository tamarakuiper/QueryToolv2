{
  "id": "holdings-by-asset-class",
  "version": 1,
  "name": "Holdings by Asset Class",
  "description": "Positions for the firm filtered by asset class, above a minimum market value.",
  "category": "Holdings",
  "enabled": true,
  "scope": { "type": "global" },
  "access": { "groups": ["advisors"], "adminOnly": false },
  "execution": {
    "dataset": "holdings",
    "timeoutSeconds": 30,
    "maxRows": 5000,
    "sql": "SELECT Symbol, SecurityName, AssetClass, Quantity, MarketValue FROM holdings WHERE FirmId = @firmId AND AssetClass IN @assetClasses AND MarketValue >= @minValue ORDER BY MarketValue DESC"
  },
  "parameters": [
    { "name": "firmId", "source": "firm", "type": "integer", "required": true, "hidden": true },
    {
      "name": "assetClasses",
      "label": "Asset class",
      "type": "string[]",
      "control": "multiSelect",
      "required": true,
      "default": ["Equity", "ETF", "Fixed Income", "Cash", "Alternative"],
      "options": [
        { "value": "Equity", "label": "Equity" },
        { "value": "ETF", "label": "ETF" },
        { "value": "Fixed Income", "label": "Fixed Income" },
        { "value": "Cash", "label": "Cash" },
        { "value": "Alternative", "label": "Alternative" }
      ]
    },
    {
      "name": "minValue",
      "label": "Minimum market value",
      "type": "number",
      "control": "number",
      "required": false,
      "default": 0,
      "min": 0
    }
  ],
  "result": {
    "title": "Holdings",
    "defaultPageSize": 25,
    "export": ["csv"],
    "columns": [
      { "field": "Symbol", "label": "Symbol", "type": "string" },
      { "field": "SecurityName", "label": "Security", "type": "string" },
      { "field": "AssetClass", "label": "Asset Class", "type": "badge" },
      { "field": "Quantity", "label": "Quantity", "type": "number" },
      { "field": "MarketValue", "label": "Market Value", "type": "currency" }
    ]
  },
  "tags": ["holdings", "advisors"]
}
